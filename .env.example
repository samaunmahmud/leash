# Copy to .env and fill in. Never commit .env.

# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
LEASH_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
LEASH_PAYPAL_CLIENT_ID=
LEASH_PAYPAL_CLIENT_SECRET=
# Optional. Leave empty: payments then go to the business account that owns this REST app, which is the only
# account Leash can refund ("Regret"). Any other payee (especially a Personal sandbox account) makes refunds fail
# with 403 PERMISSION_DENIED; Leash warns about a personal payee at startup.
LEASH_PAYPAL_PAYEE_EMAIL=
# Optional: the ID of the webhook you register (Apps & Credentials → your app → Sandbox Webhooks) for
# https://<public host>/api/paypal/webhook with CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED / DENIED / REFUNDED.
# Empty = webhooks off (the endpoint answers 503). Refunds from the dashboard work either way.
LEASH_PAYPAL_WEBHOOK_ID=

# Any OpenAI-compatible chat endpoint. Leave all three empty to run without AI (rule-based fallbacks).
# Gemini (https://ai.google.dev/gemini-api/docs/openai), key from https://aistudio.google.com/apikey:
LEASH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LEASH_LLM_API_KEY=
# gemini-3.5-flash-lite answered in about 1 s in testing (Nov 2026). gemini-2.5-flash is closed to new keys, and the
# newest flash models were often overloaded (503) or slower than the 12 s timeout.
LEASH_LLM_MODEL=gemini-3.5-flash-lite
# Optional: none / minimal / low / medium / high. Keeps thinking models inside the 12 s timeout. Leave empty for
# providers that don't accept reasoning_effort.
LEASH_LLM_REASONING_EFFORT=minimal
# Spend guard. Gemini's free tier allows about 20 requests per model per day, so stay at or under that on free tier.
LEASH_LLM_MAX_CALLS_PER_DAY=20

# Postgres (docker compose up -d). Delete these three lines (don't just blank them) for an in-memory database that resets on restart.
LEASH_DB_URL=jdbc:postgresql://localhost:5432/leash
LEASH_DB_USER=leash
LEASH_DB_PASSWORD=leash

# Hosted public demo (Render sets these from render.yaml). Locally leave them out: the dashboard stays open.
# LEASH_DEMO_PUBLIC=true            banner "Public sandbox demo", hourly reset of the demo leashes, rate limits
# LEASH_OWNER_PASSPHRASE=           guards agent keys, saved PayPal and leash edits (needed even without public mode)
# LEASH_DEMO_SEED_HISTORY=true      past-week example tugs so the mandate-learning suggestion shows (default: = public)

PORT=8080
