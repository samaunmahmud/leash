# Copy to .env and fill in. Never commit .env.

# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
LEASH_PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
LEASH_PAYPAL_CLIENT_ID=
LEASH_PAYPAL_CLIENT_SECRET=
# Sandbox business account that receives payments for the demo shop
LEASH_PAYPAL_PAYEE_EMAIL=

# Any OpenAI-compatible chat endpoint
LEASH_LLM_BASE_URL=
LEASH_LLM_API_KEY=
LEASH_LLM_MODEL=

# Postgres (docker compose up -d). Delete these three lines (don't just blank them) for an in-memory database that resets on restart.
LEASH_DB_URL=jdbc:postgresql://localhost:5432/leash
LEASH_DB_USER=leash
LEASH_DB_PASSWORD=leash

PORT=8080
